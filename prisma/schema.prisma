generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
  REFUNDED
}

enum PlanType {
  LIFETIME
  SIX_MONTHS
  TWELVE_MONTHS
  CUSTOM
}

enum ActivationStatus {
  ACTIVE
  DEACTIVATED
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  licenses    License[]
}

model License {
  id             String              @id @default(cuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  keyHash        String              @unique
  keyPreview     String
  buyerName      String?
  buyerEmail     String
  platform       String              @default("manual")
  purchaseRef    String?
  plan           PlanType            @default(LIFETIME)
  expiresAt      DateTime?
  maxActivations Int                 @default(1)
  status         LicenseStatus       @default(ACTIVE)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  activations    LicenseActivation[]
  audits         AuditLog[]

  @@index([buyerEmail])
  @@index([productId, status])
}

model LicenseActivation {
  id             String           @id @default(cuid())
  licenseId      String
  license        License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  instanceIdHash String
  instanceLabel  String?
  productVersion String?
  metadata       Json?
  status         ActivationStatus @default(ACTIVE)
  activatedAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  deactivatedAt  DateTime?

  @@unique([licenseId, instanceIdHash])
  @@index([instanceIdHash])
  @@index([licenseId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  licenseId String?
  license   License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  action    String
  actor     String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([licenseId])
  @@index([action])
}

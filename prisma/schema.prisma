generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
  REFUNDED
}

enum PlanType {
  LIFETIME
  SIX_MONTHS
  TWELVE_MONTHS
  CUSTOM
}

enum KasaEdition {
  STARTER
  PLUS
  ENTERPRISE
}

enum ActivationStatus {
  ACTIVE
  DEACTIVATED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  CLOSED
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedLeads Lead[]  @relation("LeadAssignee")
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  licenses    License[]
}

model License {
  id             String              @id @default(cuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  keyHash        String              @unique
  keyPreview     String
  keyEncrypted   String?
  buyerName      String?
  buyerEmail     String
  platform       String              @default("manual")
  purchaseRef    String?
  saleAmount     Decimal             @default(0) @db.Decimal(12, 2)
  saleCurrency   String              @default("INR")
  saleChannel    String              @default("direct")
  marketingSource String?
  soldAt         DateTime            @default(now())
  edition        KasaEdition         @default(ENTERPRISE)
  plan           PlanType            @default(LIFETIME)
  expiresAt      DateTime?
  renewalUrl     String?
  expiryNoticeLastSentAt DateTime?
  expiryNoticeCount      Int         @default(0)
  maxActivations Int                 @default(1)
  status         LicenseStatus       @default(ACTIVE)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  activations    LicenseActivation[]
  audits         AuditLog[]

  @@index([buyerEmail])
  @@index([productId, status])
  @@index([edition, status])
  @@index([expiresAt, status])
  @@index([saleChannel, soldAt])
  @@index([marketingSource, soldAt])
  @@index([soldAt])
}

model LicenseActivation {
  id             String           @id @default(cuid())
  licenseId      String
  license        License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  instanceIdHash String
  instanceLabel  String?
  productVersion String?
  metadata       Json?
  status         ActivationStatus @default(ACTIVE)
  activatedAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  deactivatedAt  DateTime?

  @@unique([licenseId, instanceIdHash])
  @@index([instanceIdHash])
  @@index([licenseId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  licenseId String?
  license   License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  action    String
  actor     String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([licenseId])
  @@index([action])
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  email        String
  institute    String?
  phone        String?
  message      String
  source       String     @default("marketing-site")
  status       LeadStatus @default(NEW)
  assignedToId String?
  assignedTo   AdminUser? @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        String?
  emailedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}
